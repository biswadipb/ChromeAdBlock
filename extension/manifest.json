{
  "manifest_version": 3,
  "name": "Chrome Ad Blocker",
  "version": "1.0",
  "minimum_chrome_version": "120",
  "description": "Blocks ads, trackers, malware domains, popups and redirects on all sites, with extra YouTube ad skipping.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "popup-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube-inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "cosmetic.js"
      ],
      "css": [
        "base.css",
        "generic.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "css": [
        "youtube.css"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "core",
        "enabled": true,
        "path": "rulesets/core.json"
      },
      {
        "id": "easylist-1",
        "enabled": true,
        "path": "rulesets/easylist-1.json"
      },
      {
        "id": "easylist-2",
        "enabled": false,
        "path": "rulesets/easylist-2.json"
      },
      {
        "id": "easyprivacy-1",
        "enabled": false,
        "path": "rulesets/easyprivacy-1.json"
      },
      {
        "id": "easyprivacy-2",
        "enabled": false,
        "path": "rulesets/easyprivacy-2.json"
      },
      {
        "id": "annoyance-1",
        "enabled": false,
        "path": "rulesets/annoyance-1.json"
      },
      {
        "id": "malware-1",
        "enabled": false,
        "path": "rulesets/malware-1.json"
      },
      {
        "id": "nocoin-1",
        "enabled": false,
        "path": "rulesets/nocoin-1.json"
      }
    ]
  }
}